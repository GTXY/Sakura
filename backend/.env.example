# ── 数据库 ────────────────────────────────────────────────────────
# 生产（MySQL）：mysql+aiomysql://sql_db_shinichi:YOUR_PASSWORD@localhost/sql_db_shinichi
# 本地（PostgreSQL）：postgresql+asyncpg://用户名@localhost/数据库名
DATABASE_URL=mysql+aiomysql://sql_db_shinichi:YOUR_PASSWORD@localhost/sql_db_shinichi

# ── JWT 签名密钥（必须修改！生成命令：python3 -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# ── CORS（多个域名用逗号分隔）
ALLOWED_ORIGINS=https://www.kudou-shinichi.cn

# ── 生产环境 Base URL
BASE_URL=https://www.kudou-shinichi.cn

# ── Google Cloud Storage Bucket 名称（本地可留空，图片功能将不可用）
GCS_BUCKET_NAME=sakura-photos-kudoushinichi
